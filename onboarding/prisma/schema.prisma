generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessType {
  individual
  company
}

enum MerchantStatus {
  pending
  under_review
  approved
  declined
  suspended
  active
}

enum VerificationStatus {
  pending
  in_progress
  verified
  failed
}

enum AccountType {
  checking
  savings
}

enum UnderwritingDecisionType {
  approved
  declined
  manual_review
}

model Partner {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(255)
  /// Integration pattern the partner uses: direct_api, embedded_ui, white_label, marketplace.
  integrationMode String @map("integration_mode") @db.VarChar(30)
  /// White-label / embedded UI customisation (logo, colours, domain, locale, email templates).
  branding      Json?
  defaultLocale String   @default("en-US") @map("default_locale") @db.VarChar(10)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  apiKeys   ApiKey[]
  merchants Merchant[]
  webhooks  Webhook[]

  @@map("partners")
}

model ApiKey {
  id        String    @id @default(uuid()) @db.Uuid
  partnerId String    @map("partner_id") @db.Uuid
  /// Human readable prefix (e.g. sk_live_a1b2c3) used for lookup and log display.
  prefix    String    @unique @db.VarChar(32)
  /// SHA-256 of the full secret; the secret itself is never stored.
  keyHash   String    @map("key_hash") @db.VarChar(64)
  /// Granted scopes, e.g. merchants:read, merchants:write, underwriting:write.
  scopes    String[]
  role      String    @default("operator") @db.VarChar(20)
  livemode  Boolean   @default(false)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("api_keys")
}

model Merchant {
  id              String         @id @default(uuid()) @db.Uuid
  /// Public, prefixed identifier exposed over the API (mer_...).
  reference       String         @unique @db.VarChar(40)
  partnerId       String         @map("partner_id") @db.Uuid
  businessType    BusinessType   @map("business_type")
  status          MerchantStatus @default(pending)
  country         String         @db.VarChar(2)
  /// legal_name, dba_name, tax_id, registration_number, mcc, website, volumes, products_sold.
  businessProfile Json           @map("business_profile")
  contact         Json
  address         Json
  compliance      Json
  processingLimits Json?         @map("processing_limits")
  /// Progressive onboarding state: which steps are done, and the collected-so-far payloads.
  onboarding      Json
  locale          String         @default("en-US") @db.VarChar(10)
  statusReason    String?        @map("status_reason")
  activatedAt     DateTime?      @map("activated_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  partner               Partner                @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  owners                Owner[]
  bankAccounts          BankAccount[]
  documents             Document[]
  verificationAttempts  VerificationAttempt[]
  riskAssessments       RiskAssessment[]
  underwritingDecisions UnderwritingDecision[]
  auditLogs             AuditLog[]
  onboardingTokens      OnboardingToken[]

  @@index([partnerId])
  @@index([status])
  @@map("merchants")
}

model OnboardingToken {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  /// SHA-256 of the token handed to the embedded UI / hosted flow.
  tokenHash  String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("onboarding_tokens")
}

model Owner {
  id                  String             @id @default(uuid()) @db.Uuid
  reference           String             @unique @db.VarChar(40)
  merchantId          String             @map("merchant_id") @db.Uuid
  firstName           String             @map("first_name") @db.VarChar(100)
  lastName            String             @map("last_name") @db.VarChar(100)
  email               String             @db.VarChar(255)
  phone               String?            @db.VarChar(20)
  dateOfBirth         DateTime           @map("date_of_birth") @db.Date
  address             Json
  ownershipPercentage Decimal            @map("ownership_percentage") @db.Decimal(5, 2)
  title               String?            @db.VarChar(100)
  /// Last 4 of the national identifier (SSN/SIN/NINO); full value is never stored.
  nationalIdLast4     String?            @map("national_id_last4") @db.VarChar(4)
  isControlProng      Boolean            @default(false) @map("is_control_prong")
  verificationStatus  VerificationStatus @default(pending) @map("verification_status")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant  Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([merchantId])
  @@map("owners")
}

model BankAccount {
  id                  String             @id @default(uuid()) @db.Uuid
  reference           String             @unique @db.VarChar(40)
  merchantId          String             @map("merchant_id") @db.Uuid
  accountNumberLast4  String             @map("account_number_last4") @db.VarChar(4)
  /// Opaque token standing in for the full account number (tokenised at rest).
  accountNumberToken  String             @map("account_number_token") @db.VarChar(255)
  routingNumber       String             @map("routing_number") @db.VarChar(34)
  accountType         AccountType        @map("account_type")
  currency            String             @db.VarChar(3)
  country             String             @db.VarChar(2)
  accountHolderName   String             @map("account_holder_name") @db.VarChar(255)
  verificationStatus  VerificationStatus @default(pending) @map("verification_status")
  verificationMethod  String?            @map("verification_method") @db.VarChar(20)
  /// Micro-deposit amounts in minor units, present while a micro_deposits check is open.
  microDeposits       Json?              @map("micro_deposits")
  isDefault           Boolean            @default(false) @map("is_default")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("bank_accounts")
}

model Document {
  id                 String             @id @default(uuid()) @db.Uuid
  reference          String             @unique @db.VarChar(40)
  merchantId         String             @map("merchant_id") @db.Uuid
  ownerId            String?            @map("owner_id") @db.Uuid
  documentType       String             @map("document_type") @db.VarChar(50)
  storageKey         String             @map("storage_key") @db.VarChar(500)
  fileName           String             @map("file_name") @db.VarChar(255)
  contentType        String             @map("content_type") @db.VarChar(100)
  fileSize           Int                @map("file_size")
  sha256             String             @db.VarChar(64)
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  /// Expiry of the underlying document (passport, licence) for compliance monitoring.
  expiresAt          DateTime?          @map("expires_at") @db.Timestamptz(6)
  metadata           Json?
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  owner    Owner?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("documents")
}

model VerificationAttempt {
  id               String             @id @default(uuid()) @db.Uuid
  reference        String             @unique @db.VarChar(40)
  merchantId       String             @map("merchant_id") @db.Uuid
  /// business | identity | bank_account
  verificationType String             @map("verification_type") @db.VarChar(50)
  /// Subject of the check: owner reference, bank account reference, or null for the business.
  subjectReference String?            @map("subject_reference") @db.VarChar(40)
  status           VerificationStatus
  provider         String?            @db.VarChar(50)
  requestData      Json?              @map("request_data")
  responseData     Json?              @map("response_data")
  errorMessage     String?            @map("error_message")
  startedAt        DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?          @map("completed_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("verification_attempts")
}

model RiskAssessment {
  id              String   @id @default(uuid()) @db.Uuid
  reference       String   @unique @db.VarChar(40)
  merchantId      String   @map("merchant_id") @db.Uuid
  riskScore       Int      @map("risk_score")
  riskLevel       String   @map("risk_level") @db.VarChar(20)
  factors         Json
  recommendations Json?
  /// onboarding | ongoing
  assessmentType  String   @map("assessment_type") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("risk_assessments")
}

model UnderwritingDecision {
  id               String                   @id @default(uuid()) @db.Uuid
  reference        String                   @unique @db.VarChar(40)
  merchantId       String                   @map("merchant_id") @db.Uuid
  decision         UnderwritingDecisionType
  reason           String?
  /// Machine-readable reasons behind the decision (explainability).
  reasonCodes      Json?                    @map("reason_codes")
  processingLimits Json?                    @map("processing_limits")
  pricingTier      String?                  @map("pricing_tier") @db.VarChar(50)
  /// automated | manual
  underwritingType String                   @map("underwriting_type") @db.VarChar(20)
  riskAssessmentId String?                  @map("risk_assessment_id") @db.Uuid
  reviewedBy       String?                  @map("reviewed_by") @db.VarChar(255)
  reviewedAt       DateTime                 @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  expiresAt        DateTime?                @map("expires_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("underwriting_decisions")
}

model Webhook {
  id        String    @id @default(uuid()) @db.Uuid
  reference String    @unique @db.VarChar(40)
  partnerId String    @map("partner_id") @db.Uuid
  url       String    @db.VarChar(500)
  events    String[]
  secret    String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  partner    Partner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([partnerId])
  @@map("webhooks")
}

model WebhookDelivery {
  id            String    @id @default(uuid()) @db.Uuid
  webhookId     String    @map("webhook_id") @db.Uuid
  eventId       String    @map("event_id") @db.VarChar(40)
  eventType     String    @map("event_type") @db.VarChar(100)
  payload       Json
  /// pending | delivered | failed
  status        String    @db.VarChar(20)
  attempts      Int       @default(0)
  responseCode  Int?      @map("response_code")
  errorMessage  String?   @map("error_message")
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([status])
  @@map("webhook_deliveries")
}

model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  partnerId    String   @map("partner_id") @db.Uuid
  key          String   @db.VarChar(255)
  method       String   @db.VarChar(10)
  path         String   @db.VarChar(500)
  /// SHA-256 of the request body, so a reused key with a different body is rejected.
  requestHash  String   @map("request_hash") @db.VarChar(64)
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([partnerId, key])
  @@map("idempotency_keys")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  merchantId   String?  @map("merchant_id") @db.Uuid
  actorId      String   @map("actor_id") @db.VarChar(255)
  /// api_key | user | system
  actorType    String   @map("actor_type") @db.VarChar(20)
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(50)
  resourceId   String?  @map("resource_id") @db.VarChar(64)
  changes      Json?
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent")
  requestId    String?  @map("request_id") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([createdAt])
  @@map("audit_logs")
}
